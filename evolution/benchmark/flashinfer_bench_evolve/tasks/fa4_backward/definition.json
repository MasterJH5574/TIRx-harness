{
  "name": "fa4_backward_fp16",
  "description": "Prepared-tensor FlashAttention-4 fp16 backward benchmark that calls flash_attn.cute.interface._flash_attn_bwd directly. Inputs include the saved forward output and float32 LSE; each timed call returns dq, dk, and dv without an autograd wrapper or forward pass.",
  "op_type": "flash_attention",
  "tags": [
    "stage:backward",
    "timing:backward-only",
    "dtype:fp16",
    "inputs:prepared-forward",
    "status:synthetic",
    "kernel:fa4"
  ],
  "axes": {
    "batch_size": {
      "type": "var"
    },
    "seq_len": {
      "type": "var"
    },
    "num_heads": {
      "type": "var"
    },
    "head_dim": {
      "type": "const",
      "value": 128
    },
    "causal": {
      "type": "var"
    }
  },
  "constraints": [
    "q.shape == k.shape == v.shape == out.shape == grad_out.shape",
    "lse.shape == (batch_size, num_heads, seq_len)",
    "q.dtype == torch.float16",
    "lse.dtype == torch.float32"
  ],
  "inputs": {
    "q": {
      "shape": [
        "batch_size",
        "seq_len",
        "num_heads",
        "head_dim"
      ],
      "dtype": "float16"
    },
    "k": {
      "shape": [
        "batch_size",
        "seq_len",
        "num_heads",
        "head_dim"
      ],
      "dtype": "float16"
    },
    "v": {
      "shape": [
        "batch_size",
        "seq_len",
        "num_heads",
        "head_dim"
      ],
      "dtype": "float16"
    },
    "out": {
      "shape": [
        "batch_size",
        "seq_len",
        "num_heads",
        "head_dim"
      ],
      "dtype": "float16",
      "description": "Saved FlashAttention-4 forward output."
    },
    "grad_out": {
      "shape": [
        "batch_size",
        "seq_len",
        "num_heads",
        "head_dim"
      ],
      "dtype": "float16"
    },
    "lse": {
      "shape": [
        "batch_size",
        "num_heads",
        "seq_len"
      ],
      "dtype": "float32",
      "description": "Saved natural-log softmax log-sum-exp from the forward pass."
    },
    "causal": {
      "shape": null,
      "dtype": "bool"
    },
    "sm_scale": {
      "shape": null,
      "dtype": "float32"
    }
  },
  "outputs": {
    "dq": {
      "shape": [
        "batch_size",
        "seq_len",
        "num_heads",
        "head_dim"
      ],
      "dtype": "float16"
    },
    "dk": {
      "shape": [
        "batch_size",
        "seq_len",
        "num_heads",
        "head_dim"
      ],
      "dtype": "float16"
    },
    "dv": {
      "shape": [
        "batch_size",
        "seq_len",
        "num_heads",
        "head_dim"
      ],
      "dtype": "float16"
    }
  },
  "reference": "#!/usr/bin/env python3\n\"\"\"Direct FlashAttention-4 backward baseline for prepared forward tensors.\"\"\"\n\nfrom __future__ import annotations\n\n\ndef run(q, k, v, out, grad_out, lse, causal, sm_scale):\n    \"\"\"Call the low-level FA4 backward operator directly.\"\"\"\n\n    from flash_attn.cute.interface import _flash_attn_bwd\n\n    return _flash_attn_bwd(\n        q=q,\n        k=k,\n        v=v,\n        out=out,\n        dout=grad_out,\n        lse=lse,\n        softmax_scale=float(sm_scale),\n        causal=bool(causal),\n    )\n"
}
